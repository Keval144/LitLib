// tsconfig.json
{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler", // or "node16", "nodenext"
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "app/api/items/[id]/route.js", "app/api/admin/borrowings/[id]/damage/route.js", "app/api/admin/borrowings/[id]/return/route.js", "app/api/admin/borrowings/route.js", "app/api/admin/fines/[id]/pay/route.js", "app/api/admin/fines/[id]/waive/route.js", "app/api/admin/reservations/[id]/checkout/route.js", "app/api/admin/reservations/route.js"],
  "exclude": ["node_modules"]
}